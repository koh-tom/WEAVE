{
    "abi_version": 1,
    "name": "shoutout",
    "version": "1.0.0",
    "description": "Streamer command bot: !so <name> shows a shoutout card on stream",
    "permissions": {
        "publish": ["core.obs.request.SetInputSettings", "core.obs.request.SetSceneItemEnabled"],
        "subscribe": ["ext.twitch.chat.message", "core.system.tick"],
        "data_access": ["pii"]
    },
    "rate_limit_eps": 20
}
